{
  "problemMatcher": [
    {
      "owner": "msvc",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?([^\\s].*?)\\((\\d+)(?:,(\\d+))?(?:,\\d+,\\d+)?\\)\\s*:\\s+(?:fatal\\s+)?(error|warning)\\s+([A-Z]+\\d+)\\s*:\\s*(.*?)(?:\\s+\\[[^\\]]+\\.vcxproj\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    },
    {
      "owner": "googletest",
      "pattern": [
        {
          "regexp": "^([^\\s].*?)\\((\\d+)\\): error: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      ]
    }
  ]
}
