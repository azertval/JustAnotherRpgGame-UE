# Normalisation automatique des fins de ligne (LF dans le dépôt).
* text=auto eol=lf

# Scripts Windows : CRLF forcé.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Sources et build : du texte (D-52).
*.cpp          text
*.h            text
*.hpp          text
*.cs           text
*.py           text
*.ini          text
*.json         text
*.uproject     text
*.uplugin      text
*.yml          text
*.md           text
CMakeLists.txt text

# Sorties binaires du moteur (D-52) : régénérées par script, suivies en Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# Assets binaires (Elements/) — pas de diff.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.dds binary
*.tga binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
# Maillages : glTF binaire.
*.glb binary

# Étude des métiers : trois fichiers de texte au-delà du plafond de 5 Mio (le modèle fait 40 Mio),
# et leur copie dans le site rendu. En Git LFS pour ne pas peser dans le pack ; les nommer ici est
# la décision de les admettre (check_binary_files.py n'exempte du plafond que ce qui est en LFS).
/Documentation/Metiers/explorateur.html                                             filter=lfs diff=lfs merge=lfs -text
/Documentation/Metiers/Donnees/metiers-tanares-modele.json                          filter=lfs diff=lfs merge=lfs -text
/Documentation/Metiers/Donnees/metiers-tanares-alimentation-v3.json                 filter=lfs diff=lfs merge=lfs -text
/Documentation/Metiers/generated/site/Metiers/explorateur.html                      filter=lfs diff=lfs merge=lfs -text
/Documentation/Metiers/generated/site/Metiers/Donnees/metiers-tanares-modele.json   filter=lfs diff=lfs merge=lfs -text
/Documentation/Metiers/generated/site/Metiers/Donnees/metiers-tanares-alimentation-v3.json filter=lfs diff=lfs merge=lfs -text
